<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.vincent.crm.system.mapper.UserRoleMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.vincent.crm.system.domain.UserRole">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="role_id" property="roleId"/>
        <result column="organization_id" property="organizationId"/>
    </resultMap>

    <!-- 根据主键查询 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT id, user_id, role_id, organization_id
        FROM sys_user_role
        WHERE id = #{id}
    </select>

    <!-- 根据主键批量查询 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id, user_id, role_id, organization_id
        FROM sys_user_role
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 新增 -->
    <insert id="insert" parameterType="cn.vincent.crm.system.domain.UserRole">
        INSERT INTO sys_user_role (id, user_id, role_id, organization_id)
        VALUES (#{id}, #{userId}, #{roleId}, #{organizationId})
    </insert>

    <!-- 批量新增 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO sys_user_role (id, user_id, role_id, organization_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.userId}, #{item.roleId}, #{item.organizationId})
        </foreach>
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="cn.vincent.crm.system.domain.UserRole">
        UPDATE sys_user_role
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="organizationId != null">organization_id = #{organizationId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键批量删除 -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM sys_user_role
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
