<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.vincent.crm.customer.mapper.CustomerOwnerMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.vincent.crm.customer.domain.CustomerOwner">
        <id column="id" property="id"/>
        <result column="customer_id" property="customerId"/>
        <result column="from_owner" property="fromOwner"/>
        <result column="to_owner" property="toOwner"/>
        <result column="operation_type" property="operationType"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operate_time" property="operateTime"/>
        <result column="organization_id" property="organizationId"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, customer_id, from_owner, to_owner, operation_type, operator_id, operate_time, organization_id
    </sql>

    <!-- 根据主键查询 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM customer_owner
        WHERE id = #{id}
    </select>

    <!-- 根据主键批量查询 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM customer_owner
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 新增 -->
    <insert id="insert" parameterType="cn.vincent.crm.customer.domain.CustomerOwner">
        INSERT INTO customer_owner (id, customer_id, from_owner, to_owner, operation_type,
                                    operator_id, operate_time, organization_id)
        VALUES (#{id}, #{customerId}, #{fromOwner}, #{toOwner}, #{operationType},
                #{operatorId}, #{operateTime}, #{organizationId})
    </insert>

    <!-- 批量新增 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO customer_owner (id, customer_id, from_owner, to_owner, operation_type,
                                    operator_id, operate_time, organization_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.customerId}, #{item.fromOwner}, #{item.toOwner}, #{item.operationType},
             #{item.operatorId}, #{item.operateTime}, #{item.organizationId})
        </foreach>
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="cn.vincent.crm.customer.domain.CustomerOwner">
        UPDATE customer_owner
        <set>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="fromOwner != null">from_owner = #{fromOwner},</if>
            <if test="toOwner != null">to_owner = #{toOwner},</if>
            <if test="operationType != null">operation_type = #{operationType},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
            <if test="operateTime != null">operate_time = #{operateTime},</if>
            <if test="organizationId != null">organization_id = #{organizationId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键批量删除 -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM customer_owner
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
