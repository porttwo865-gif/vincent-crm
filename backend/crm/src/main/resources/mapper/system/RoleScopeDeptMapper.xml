<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.vincent.crm.system.mapper.RoleScopeDeptMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.vincent.crm.system.domain.RoleScopeDept">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="dept_id" property="deptId"/>
    </resultMap>

    <!-- 根据主键查询 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT id, role_id, dept_id
        FROM role_scope_dept
        WHERE id = #{id}
    </select>

    <!-- 根据主键批量查询 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id, role_id, dept_id
        FROM role_scope_dept
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 新增 -->
    <insert id="insert" parameterType="cn.vincent.crm.system.domain.RoleScopeDept">
        INSERT INTO role_scope_dept (id, role_id, dept_id)
        VALUES (#{id}, #{roleId}, #{deptId})
    </insert>

    <!-- 批量新增 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO role_scope_dept (id, role_id, dept_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.roleId}, #{item.deptId})
        </foreach>
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="cn.vincent.crm.system.domain.RoleScopeDept">
        UPDATE role_scope_dept
        <set>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键批量删除 -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM role_scope_dept
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
