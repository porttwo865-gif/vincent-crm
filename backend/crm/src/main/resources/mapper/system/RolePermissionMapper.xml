<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.vincent.crm.system.mapper.RolePermissionMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.vincent.crm.system.domain.RolePermission">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="permission_id" property="permissionId"/>
    </resultMap>

    <!-- 根据主键查询 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT id, role_id, permission_id
        FROM sys_role_permission
        WHERE id = #{id}
    </select>

    <!-- 根据主键批量查询 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id, role_id, permission_id
        FROM sys_role_permission
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 新增 -->
    <insert id="insert" parameterType="cn.vincent.crm.system.domain.RolePermission">
        INSERT INTO sys_role_permission (id, role_id, permission_id)
        VALUES (#{id}, #{roleId}, #{permissionId})
    </insert>

    <!-- 批量新增 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO sys_role_permission (id, role_id, permission_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.roleId}, #{item.permissionId})
        </foreach>
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="cn.vincent.crm.system.domain.RolePermission">
        UPDATE sys_role_permission
        <set>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="permissionId != null">permission_id = #{permissionId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键批量删除 -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM sys_role_permission
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
