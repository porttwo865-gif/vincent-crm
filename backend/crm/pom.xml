<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.vincent</groupId>
        <artifactId>vincent-crm</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>crm</artifactId>
    <name>CRM</name>
    <description>CRM 业务模块（线索、客户、商机、合同等）</description>

    <dependencies>
        <!-- 依赖 framework 模块（传递性提供 Web/MyBatis/Shiro/Redisson/PageHelper 等编译期依赖） -->
        <dependency>
            <groupId>cn.vincent</groupId>
            <artifactId>framework</artifactId>
        </dependency>

        <!-- Spring Boot Data Redis（测试运行时需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除默认的 logback 依赖，避免与 shiro 带入的 log4j2 冲突 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MySQL Connector（测试运行时需要） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Flyway MySQL（测试环境执行 Flyway 迁移） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 排除默认日志依赖，避免 log4j-to-slf4j 与 log4j-slf4j2-impl 冲突 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 测试资源目录配置：包含 app 模块的 Flyway 迁移脚本和 i18n 文件 -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- 将 app 模块的资源目录加入测试资源（包含 Flyway 迁移脚本和 i18n） -->
            <testResource>
                <directory>../app/src/main/resources</directory>
            </testResource>
        </testResources>
    </build>

</project>
