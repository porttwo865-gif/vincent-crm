# ============================================================
# VincentCRM 生产环境变量配置
# 复制此文件为 .env 并修改为实际值
# ============================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=vincent_crm

# Redis 配置
REDIS_PASSWORD=

# 后端应用配置
JWT_SECRET=your_secret_key_here

# Spring Boot 数据源覆盖（docker-compose.prod.yml 默认使用内嵌服务，无需修改）
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/vincent_crm?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password

# Spring Boot Redis 覆盖
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=

# JVM 参数调优
# JAVA_OPTS=-Xms256m -Xmx512m
